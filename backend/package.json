    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.5",
    "@types/supertest": "^7.0.0",
    "jest": "^30.0.0",
